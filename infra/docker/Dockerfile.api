# --- Build stage ---
FROM python:3.12-slim AS builder
WORKDIR /app
# git is required by uv to fetch git dependencies (gatedops); ca-certificates
# for TLS. Runtime stages COPY the built .venv, so git is not needed there.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv
COPY pyproject.toml uv.lock* ./
RUN uv sync --frozen --no-dev --no-install-project
COPY src/ src/
RUN uv sync --frozen --no-dev

# --- Runtime stage (api) ---
FROM python:3.12-slim AS api
WORKDIR /app
RUN groupadd -r aether && useradd -r -g aether aether
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/src /app/src
COPY infra/docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENV PATH="/app/.venv/bin:$PATH"
USER aether
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1
ENTRYPOINT ["/entrypoint.sh"]

# --- Web builder stage ---
# Extends base builder with web-only deps + web/ directory.
# Note: src/ is inherited from builder. The web runtime does not import it directly
# (it communicates with the API via HTTP); it's present for consistency.
FROM builder AS web-builder
COPY web/ web/
RUN uv sync --frozen --no-dev --extra web

# --- Web runtime stage ---
FROM python:3.12-slim AS web
WORKDIR /app
RUN groupadd -r aether && useradd -r -g aether aether
ENV PYTHONPATH="/app"
COPY --from=web-builder /app/.venv /app/.venv
COPY --from=web-builder /app/src /app/src
COPY --from=web-builder /app/web /app/web
ENV PATH="/app/.venv/bin:$PATH"
USER aether
EXPOSE 8501
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8501/_stcore/health')" || exit 1
CMD ["streamlit", "run", "web/app.py", "--server.port=8501", "--server.address=0.0.0.0"]

